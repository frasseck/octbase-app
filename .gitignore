# API binary and database
octbase-api/octbase-api
octbase-api/octbase.db

# Postgres data (podman-compose bind mount, ${PGDATA_DIR}). The glob covers
# both documented values: ./pgdata, the compose default, and ./pgdata_dev,
# which the dev overlay's .env uses — only the first was listed, so a dev stack
# left an unignored directory in the tree that git could not even read
# ("warning: could not open directory 'pgdata_dev/'" on every status).
/pgdata*/

# Uploaded attachment files (podman-compose bind mount; ATTACHMENTS_DIR)
/attachments/

# Go build cache
octbase-api/vendor/

.vscode
.env.local
.env

# Editor and OS
.DS_Store
*.swp
*.swo
.venv-octbase-tests

# Stray run output (nohup, redirected logs)
nohup.out
*.log

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
# Build output (37b stage 2)
node_modules/
*/dist/
# The standalone-demo artifact (one self-contained IIFE bundle, opened from
# disk — see octbase-frontend/vite.standalone.config.js). Built, not committed.
*/dist-standalone/
