COMPOSE_PROJECT_NAME=octbase

# ── Compose ports (host-side mappings) ───────────────────
# Host ports for Postgres and the API bind to loopback (BIND_ADDR) by default so
# they are not published on the host's public interface; the frontend Caddy
# reaches the API over the compose network. Set BIND_ADDR=0.0.0.0 only if you
# deliberately need to reach Postgres/API directly from outside the host.
BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080

# Interface the frontend (the front door) publishes on. Separate from BIND_ADDR
# on purpose: BIND_ADDR governs Postgres and the API, which should essentially
# never be public, whereas a standalone stack's front door normally IS the public
# entry — one variable could not express both.
#
#   0.0.0.0    (default) the stack serves the internet directly.
#   127.0.0.1  an edge proxy ON THIS HOST fronts the stack. Required before
#              setting OCTBASE_FRONTEND_TRUSTED_PROXIES — see that variable.
FRONTEND_BIND_ADDR=0.0.0.0

# ── Postgres data directory ──────────────────────────────
# Each compose stack (e.g. main vs. dev) must use its own directory -
# sharing one between two running postgres instances corrupts the data.
PGDATA_DIR=./pgdata

# ── Compose database credentials ─────────────────────────
# Used by podman-compose.yml for the postgres service and to build
# OCTBASE_DATABASE_URL for the API container.
POSTGRES_DB=octbase
POSTGRES_USER=octbase
# REQUIRED — there is no default in the deployable compose file. Generate a
# strong value (e.g. `openssl rand -base64 24`); do not ship "octbase".
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-24
# TLS mode of the API's DB connection built by podman-compose.yml. `disable`
# is only acceptable for the bundled Postgres on the private container
# network; set `require` (or `verify-full`) for any external/managed database.
POSTGRES_SSLMODE=disable

# ── Database ──────────────────────────────────────────────
# Only used when running the API outside of podman-compose.
OCTBASE_DATABASE_URL=postgres://octbase:octbase@localhost:5432/octbase?sslmode=disable

# Optional least-privilege role split (security L10). By default the API serves
# traffic AND runs migrations as the role in OCTBASE_DATABASE_URL — the database
# owner, a superuser in the stock Postgres image — so SQL injection or an app
# compromise reaches the whole DB server. To separate DDL from DML, point
# OCTBASE_DATABASE_URL at a restricted role that only has SELECT/INSERT/UPDATE/
# DELETE on the app tables, and set OCTBASE_MIGRATE_DATABASE_URL to the owner
# role that migrations run as. The owner connection is opened only for the
# migration step and closed immediately after.
#
# Leave OCTBASE_MIGRATE_DATABASE_URL unset (the default) to keep the legacy
# single-role behaviour — the bundled single-container Postgres is fine with one
# role. This split is aimed at external/managed databases.
#
# Provision the restricted role with scripts/db-least-privilege.sql; see
# docs/operations.md ("Least-privilege runtime database role").
# OCTBASE_MIGRATE_DATABASE_URL=postgres://octbase:owner-password@localhost:5432/octbase?sslmode=require

# DB connection pool, per API instance. Defaults match the original single-stack
# sizing (25/5). When many API instances share one Postgres, lower these (or put
# pgBouncer in front) so N*max_open stays under the server's max_connections.
# See docs/hosting-concept.md §4.
OCTBASE_DB_MAX_OPEN_CONNS=25
OCTBASE_DB_MAX_IDLE_CONNS=5

# Server-side statement_timeout applied to every request-pool connection: a
# query that runs longer is cancelled by PostgreSQL, freeing its pooled
# connection instead of pinning it forever. This is the backstop against a
# single stuck query slowly exhausting the pool and deadlocking the whole API
# (every request, including /health, then hangs on connection acquisition).
# Go duration; 0 disables. NOT applied to the migration connection (long DDL).
OCTBASE_DB_STATEMENT_TIMEOUT=30s

# ── Auth ──────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
OCTBASE_JWT_SECRET=change-this-in-production
OCTBASE_JWT_ACCESS_TTL=15m
OCTBASE_JWT_REFRESH_TTL=1h

# ── CORS ──────────────────────────────────────────────────
OCTBASE_CORS_ORIGIN=http://localhost:8080

# ── SMTP (leave HOST blank to use stdout dev-mode logging) ─
# Blank OCTBASE_SMTP_HOST logs mail to stdout; set a real relay in production.
# Mailpit (captured dev mail) is NOT part of the deployable stack — for local
# development layer the override, which points OCTBASE_SMTP_HOST at it:
#   podman-compose -f podman-compose.yml -f podman-compose.dev.yml up -d
OCTBASE_SMTP_HOST=
OCTBASE_SMTP_PORT=587
OCTBASE_SMTP_FROM=noreply@octbase.io
OCTBASE_SMTP_USER=
OCTBASE_SMTP_PASS=
# Mailpit settings (dev override only; UI bound to 127.0.0.1, never public).
MAILPIT_HTTP_PORT=8025
# Basic auth for the Mailpit UI/API; empty keeps the default octbase:octbase.
MAILPIT_UI_AUTH=

# ── GDPR data retention (days) ────────────────────────────
# Audit logs carry IP address + user agent; activity entries carry user actions.
# Both are purged daily past these windows (Art. 5(1)(e) storage limitation).
# 0 disables a purge — only do that if a client contract requires longer
# retention, and document it in the client's records of processing.
OCTBASE_AUDIT_RETENTION_DAYS=365
OCTBASE_ACTIVITY_RETENTION_DAYS=365

# ── SCM repository connections ────────────────────────────
# AES-256 key used to encrypt SCM access tokens at rest. Must decode
# (base64 or hex) to exactly 32 bytes. Required to add a repository
# connection with a personal access token or OAuth. Generate with:
#   openssl rand -base64 32
OCTBASE_SCM_ENC_KEY=

# ── Multi-factor authentication (TOTP) ────────────────────
# AES-256 key used to encrypt users' TOTP secrets at rest. Must decode
# (base64 or hex) to exactly 32 bytes. Deliberately separate from
# OCTBASE_SCM_ENC_KEY so a leaked/rotated key stays scoped to one subsystem.
# Required before any user can enroll in MFA. Generate with:
#   openssl rand -base64 32
OCTBASE_MFA_ENC_KEY=

# MFA enforcement: require two-factor auth to obtain a session.
#   off    — MFA optional (default)
#   admins — required for ADMIN and SUPER_ADMIN accounts
#   all    — required for every account
# When set, a login for an in-scope account without MFA returns a scoped
# enrollment challenge (no session) until the user completes TOTP setup. Only
# enable once the frontend that handles the forced-enrollment step is deployed.
OCTBASE_REQUIRE_MFA=off

# How long a caller has to submit their TOTP/recovery code after the password
# check before having to log in again. Go duration syntax; default 5m.
OCTBASE_MFA_CHALLENGE_TTL=5m

# OAuth apps (optional — only needed for "Connect with OAuth"). The callback
# URL to register in each provider is:
#   ${OCTBASE_OAUTH_REDIRECT_BASE}/api/v1/oauth/<github|gitlab|bitbucket>/callback
OCTBASE_OAUTH_REDIRECT_BASE=
OCTBASE_OAUTH_GITHUB_CLIENT_ID=
OCTBASE_OAUTH_GITHUB_CLIENT_SECRET=
OCTBASE_OAUTH_GITLAB_CLIENT_ID=
OCTBASE_OAUTH_GITLAB_CLIENT_SECRET=
OCTBASE_OAUTH_BITBUCKET_CLIENT_ID=
OCTBASE_OAUTH_BITBUCKET_CLIENT_SECRET=
# Per-provider endpoint/scope overrides (optional — for self-hosted GitLab or
# GitHub Enterprise; defaults are each provider's public cloud endpoints).
# Same pattern for GITLAB/BITBUCKET.
#OCTBASE_OAUTH_GITHUB_AUTH_URL=
#OCTBASE_OAUTH_GITHUB_TOKEN_URL=
#OCTBASE_OAUTH_GITHUB_SCOPE=

# ── Webhooks ──────────────────────────────────────────────
OCTBASE_WEBHOOK_SECRET_BITBUCKET=
OCTBASE_WEBHOOK_SECRET_GITHUB=

# ── App ───────────────────────────────────────────────────
# Public base URL of the app. Used to build links in outgoing email
# (invitation accept, task deep-links) and the OAuth post-connect redirect, so
# set it to the real host (e.g. https://dev.octbase.io) — NOT localhost — in any
# deployment, otherwise recipients get unreachable links.
OCTBASE_APP_URL=http://localhost:8080
OCTBASE_DEMO_MODE=false
PORT=8000
# App version shown in /health, /api/v1/version, /api/v1/config, and the
# desktop app's bottom-center version tag. Always stamp the real version here
# per client/deployment — an unstamped build falls back to "beta" (the tag
# then reads "octbase beta"; see defaultAppVersion in cmd/octbase-api/main.go).
# The value here tracks the newest released version — it must always name a
# version that has a tag and a dated CHANGELOG.md entry, never one that is
# merely planned. Bump it as part of the release cut.
OCTBASE_APP_VERSION=1.0.1

# ── Initial administrator ─────────────────────────────────
# Creates the installation's first SUPER_ADMIN on startup, and only while the
# users table is still empty. Without it a fresh non-demo install has no way in
# at all: there is no public signup, the user API refuses to assign SUPER_ADMIN,
# and an invited user always lands as USER. Provisioning tools set these; a
# hand-installed stack can too.
#
# Both keys must be set together, or neither. Once the admin exists they are
# ignored on every later start, so they can be left in place — an installation
# that already has users will not fail to boot over a stale or malformed value.
#
# The password is passed as a BCRYPT HASH, never in cleartext, so no reusable
# human credential has to live in this file. Generate one with:
#   python3 -c 'import bcrypt,sys; print(bcrypt.hashpw(sys.argv[1].encode(), bcrypt.gensalt(12)).decode())' '<password>'
#   htpasswd -bnBC 12 "" '<password>' | tr -d ':\n'
# A cleartext value here is rejected at startup rather than stored as-is (which
# would produce an account nobody could log into).
OCTBASE_BOOTSTRAP_ADMIN_EMAIL=
OCTBASE_BOOTSTRAP_ADMIN_PASSWORD_HASH=

# ── Installation limits ───────────────────────────────────
# Maximum number of user accounts the installation may hold, including the
# admin (counts every non-deleted account: active, disabled and invited).
# Enforced on user creation and on invitation create/accept. 0 = unlimited.
OCTBASE_MAX_USERS=5

# ── Attachments ───────────────────────────────────────────
# Host directory backing the API's attachment volume (compose-level). Like
# PGDATA_DIR, each stack needs its OWN directory — two stacks sharing one would
# mix their uploaded files. Mounted with `:U` so podman chowns it to the API
# container's non-root user (UID 10001).
ATTACHMENTS_DIR=./attachments

# Path INSIDE the API container where those files are written; must match the
# mount target in podman-compose.yml. Uploads are disabled if the directory
# cannot be created. OCTBASE_MAX_UPLOAD_MB caps the size (in MiB) of a single
# uploaded file; OCTBASE_MAX_USER_STORAGE_MB caps the total stored size of all
# files one user has uploaded (512 MB = 0.5 GB per user). 0 = unlimited.
OCTBASE_ATTACHMENTS_DIR=/data/attachments
OCTBASE_MAX_UPLOAD_MB=10
OCTBASE_MAX_USER_STORAGE_MB=512

# ── Security ──────────────────────────────────────────────
# Set to true in production (TLS terminated at reverse proxy) so the
# refresh cookie carries the Secure flag. Leave false for local HTTP dev.
# ENFORCED: outside demo mode (OCTBASE_DEMO_MODE!=true) the API refuses to start
# unless this is "true" (and unless OCTBASE_APP_URL is set), so a forgotten flag
# fails closed instead of silently shipping an insecure cookie.
OCTBASE_SECURE_COOKIES=false

# Trusted reverse-proxy IPs/CIDRs (comma-separated) whose X-Forwarded-For /
# X-Real-IP headers are honored for the real client IP. Leave EMPTY when the API
# is not behind a proxy: forwarding headers are then ignored so they can't be
# spoofed to bypass per-IP rate limiting or forge audit-log IPs.
#
# Set this to the API's IMMEDIATE PEER — for the bundled stack that is the
# frontend Caddy container, so use the compose network's subnet:
#
#   podman network inspect ${COMPOSE_PROJECT_NAME:-octbase}_default \
#     --format '{{range .Subnets}}{{.Subnet}}{{end}}'      # e.g. 10.89.4.0/24
#
# Use the SUBNET, not the container's address: container IPs are reassigned on
# recreate, and a stale /32 silently stops matching — which fails back to one
# shared rate-limit bucket for the whole installation rather than failing loudly.
#
# Trust ONLY private addresses you control. Never list a public IP, even one your
# edge proxy legitimately connects from: the API returns the right-most XFF entry
# that is NOT trusted, so a trusted public address becomes a terminator that
# promotes whatever an attacker puts to its left into "the client". See
# TestRealIP_TrustingAPublicEdgeIPIsUnsafe in internal/shared/realip_test.go.
#
# This alone is not enough behind the bundled front door: the frontend Caddy
# overwrites the inbound chain unless OCTBASE_FRONTEND_TRUSTED_PROXIES is also
# set. Both are needed, and only in the loopback-bound topology described there.
OCTBASE_TRUSTED_PROXIES=

# Proxy addresses whose X-Forwarded-For the FRONTEND Caddy preserves rather than
# overwrites. Empty (the default) trusts nobody and is safe in every topology; it
# is also why an out-of-the-box stack rate-limits all clients as one bucket.
#
# ⚠ Set this ONLY when FRONTEND_BIND_ADDR=127.0.0.1 and an edge proxy on this
# host is the sole way in. Rootless podman NATs published-port traffic, so the
# frontend Caddy sees its own container address as the peer for EVERY caller and
# cannot distinguish your edge proxy from a stranger. With the port public,
# trusting headers lets anyone forge their client IP and bypass rate limiting
# altogether — strictly worse than a shared bucket. Unreachability of the port,
# not the header, is what makes this safe.
#
# `private_ranges` is the value that fits the bundled topology (the NAT means the
# peer is always a compose-network address). Requires the API's
# OCTBASE_TRUSTED_PROXIES above to be set too, or the API ignores the chain.
OCTBASE_FRONTEND_TRUSTED_PROXIES=

# ── Installation password (front-door HTTP Basic Auth) ────
# Lock the whole browser-facing installation behind a single shared password —
# handy for a not-yet-launched client stack sitting on a public URL. Off by
# default (both keys blank/unset). The front door keeps serving openly until you
# BOTH flip the switch AND supply a password hash — see the two steps below.
#
# Enabling takes TWO entries (podman-compose can't derive the switch from the
# hash, and an empty password would crash the front door, so the switch is
# explicit):
#   1. OCTBASE_SITE_AUTH=on          — the on/off switch (empty/unset = off)
#   2. OCTBASE_SITE_PASSWORD_HASH=…  — a *bcrypt hash* of the password. The
#      frontend's Caddy image is shell-less and cannot hash a plaintext at
#      runtime, so generate the hash yourself:
#        podman run --rm registry.access.redhat.com/hi/caddy caddy hash-password --plaintext 'your-password'
#      (or any local Caddy: caddy hash-password --plaintext 'your-password')
#      Paste the resulting `$2a$…` string below and restart the frontend
#      container. The plaintext is never stored. Setting the hash but leaving
#      OCTBASE_SITE_AUTH unset leaves the door OPEN; setting the switch on
#      without a hash makes the front door refuse to start — set both.
#
# Scope: the desktop app, the mobile app under /m/, the static pages and the
# API docs. It deliberately does NOT cover /api/* or /health — the SPA
# authenticates the API with a Bearer JWT (same HTTP header Basic Auth uses),
# the SCM webhook receivers authenticate by HMAC, and health probes carry no
# credentials. The API therefore keeps its own JWT login as the real security
# boundary; this gate only hides the UI from casual visitors.
OCTBASE_SITE_AUTH=
OCTBASE_SITE_PASSWORD_HASH=
# Username shown in the browser's Basic Auth prompt (default: octbase).
OCTBASE_SITE_USER=octbase

# ── Optional features ─────────────────────────────────────
# Toggles exposed to the SPA via GET /api/v1/config. Default on; set to "false"
# to hide the feature. taskView = the Task view (a status-grouped management list
# over board + backlog tasks, with bulk "Set status"); the underlying task-list
# engine that the Backlog also uses is always present.
OCTBASE_FEATURE_TASKVIEW=true

# Deployment edition: TEAM, BUSINESS or ENTERPRISE (case-insensitive;
# missing/invalid → ENTERPRISE, i.e. the full app). Editions gate optional
# product surface per client. Currently: Jira CSV import (project menu →
# "Import Jira CSV", POST /api/v1/projects/{id}/import/jira-csv) is included
# in ENTERPRISE and bookable as an additional option in BUSINESS (see
# OCTBASE_OPTION_JIRA_IMPORT below); TEAM can never activate it. When the
# import is off, the menu entry is hidden and the endpoint answers
# 403 FEATURE_DISABLED. The edition and the derived features.jiraCsvImport
# flag are exposed via GET /api/v1/config.
OCTBASE_EDITION=ENTERPRISE

# Additional bookable option (default off, unlike the default-on
# OCTBASE_FEATURE_* flags): activates the Jira CSV import in the BUSINESS
# edition. Only honored there — ENTERPRISE includes the import anyway and
# TEAM cannot activate it (the flag is ignored with a warning).
#OCTBASE_OPTION_JIRA_IMPORT=true

# ── Observability ─────────────────────────────────────────
# debug | info | warn | error
OCTBASE_LOG_LEVEL=info
